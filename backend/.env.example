DATABASE_URL=postgresql://askboard:askboard@localhost:5433/askboard
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
AUTO_MIGRATE=true
MAX_UPLOAD_MB=50
STATEMENT_TIMEOUT_MS=10000
CORS_ORIGINS=http://localhost:5173
# LLM used to answer questions (openrouter | bedrock)
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
LLM_TIMEOUT_SECONDS=60
# Bedrock (only when LLM_PROVIDER=bedrock; pip install -e .[bedrock])
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS_REGION=us-east-1

# Generated SQL limits
MAX_QUERY_ROWS=1000
MAX_CORRECTION_ATTEMPTS=2

LOG_LEVEL=INFO
LOG_FORMAT=text

# Integration tests
TEST_DATABASE_URL=postgresql://askboard:askboard@localhost:5433/askboard_test
